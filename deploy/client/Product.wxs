<?ifndef CorporateSigningThumbprint ?>
  <?define CorporateSigningThumbprint = "0000000000000000000000000000000000000000" ?>
<?endif?>
<?ifndef PackageTrustMode ?>
  <?define PackageTrustMode = "INSPECT_ONLY_REFUSES_INSTALL" ?>
<?endif?>
<?ifndef ProductVersion ?>
  <?define ProductVersion = "0.1.8" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RegenBio Overseas Access"
      Manufacturer="RegenBio"
      Version="$(var.ProductVersion)"
      UpgradeCode="A4D8477C-7F2D-46E6-9B5C-65BE7E8474E1"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">
    <SummaryInformation Description="RegenBio Overseas Access Windows client" Manufacturer="RegenBio" />
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of RegenBio Overseas Access is already installed. Downgrades are not permitted."
        Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="PROMPTROLLBACKCOST" Value="F" />
    <Launch Condition="NOT RollbackDisabled AND NOT DISABLEROLLBACK AND PROMPTROLLBACKCOST = &quot;F&quot;" Message="Windows Installer rollback must be enabled to safely install, upgrade, or remove this product." />
    <CustomAction Id="RequireRollbackEnabled" Error="Rollback was disabled after costing. No product mutation is permitted." />

    <Property Id="ARPCONTACT" Value="RegenBio IT" />
    <Property Id="ARPCOMMENTS" Value="Managed corporate overseas-access client" />
    <Property Id="ARPNOREPAIR" Value="0" />
    <Property Id="PACKAGE_TRUST_MODE" Value="$(var.PackageTrustMode)" />

    <!-- First-party executable is embedded in the Binary table. The inspect-only
         default thumbprint cannot match a valid signer, so this package refuses
         install, repair, and upgrade before InstallInitialize. -->
    <Binary Id="InstallerVerifierBinary" SourceFile="installer-verifier.exe" />
    <CustomAction
        Id="VerifyPackageTrust"
        BinaryRef="InstallerVerifierBinary"
        ExeCommand="package --msi &quot;[OriginalDatabase]&quot; --thumbprint &quot;$(var.CorporateSigningThumbprint)&quot;"
        Execute="immediate"
        Return="check" />
    <CustomAction
        Id="VerifyInstalledPayload"
        BinaryRef="InstallerVerifierBinary"
        ExeCommand="payload --program-files &quot;C:\Program Files\RegenBio\OverseasAccess&quot; --program-data &quot;C:\ProgramData\RegenBio\OverseasAccess&quot; --manifest &quot;C:\ProgramData\RegenBio\OverseasAccess\artifact-manifest.json&quot; --signature &quot;C:\ProgramData\RegenBio\OverseasAccess\artifact-manifest.json.p7s&quot; --thumbprint &quot;$(var.CorporateSigningThumbprint)&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction Id="RollbackClientFirewall" BinaryRef="InstallerVerifierBinary" ExeCommand="firewall-rollback" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="InstallClientFirewall" BinaryRef="InstallerVerifierBinary" ExeCommand="firewall-install" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveClientFirewall" BinaryRef="InstallerVerifierBinary" ExeCommand="firewall-uninstall" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CleanupOwnedRuntime" BinaryRef="InstallerVerifierBinary" ExeCommand="runtime-cleanup" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="PrepareClientUpgrade" BinaryRef="InstallerVerifierBinary" ExeCommand="prepare-upgrade" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackUpgradeSnapshot" BinaryRef="InstallerVerifierBinary" ExeCommand="upgrade-rollback" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="BackupUpgradeSnapshot" BinaryRef="InstallerVerifierBinary" ExeCommand="upgrade-backup" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RestoreUpgradeSnapshot" BinaryRef="InstallerVerifierBinary" ExeCommand="upgrade-restore" Execute="deferred" Impersonate="no" Return="check" />
    <!-- Last and ONLY commit action. Cleanup failure is logged by MSI and kept
         as a durable receipt for automatic maintenance/uninstall retry; it must
         never request rollback after deleting rollback payload. -->
    <CustomAction Id="CommitUpgradeSnapshot" BinaryRef="InstallerVerifierBinary" ExeCommand="upgrade-commit" Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="MaintainUpgradeSnapshot" BinaryRef="InstallerVerifierBinary" ExeCommand="upgrade-maintenance" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="InstallSharedRoot" BinaryRef="InstallerVerifierBinary" ExeCommand="shared-root-install" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty
        Id="MsiSafeRemove"
        Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;[#InstallerHarnessFile]&quot; -Mode Uninstall -MsiPreRemove"
        Before="MsiSafeRemove"
        Sequence="execute"
        Condition="REMOVE~=&quot;ALL&quot;" />
    <CustomAction
        Id="MsiSafeRemove"
        BinaryRef="Wix4UtilCA_X64"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RequireRollbackEnabled" After="InstallInitialize" Condition="RollbackDisabled OR DISABLEROLLBACK OR PROMPTROLLBACKCOST &lt;&gt; &quot;F&quot;" />
      <!-- The old cached MSI must see verified replacement files while the
           replacement service is still stopped. Backup occurs after StopServices;
           its rollback is therefore before service restart in the reverse script. -->
      <Custom Action="PrepareClientUpgrade" Before="StopServices" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <!-- Nested old-product removal belongs to the outer upgrade snapshot.
           Ordinary maintenance/uninstall must finish any previous cleanup first. -->
      <Custom Action="MaintainUpgradeSnapshot" Before="PrepareClientUpgrade" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackUpgradeSnapshot" After="StopServices" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="BackupUpgradeSnapshot" After="RollbackUpgradeSnapshot" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
          Action="MsiSafeRemove"
          Before="StopServices"
          Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom
          Action="VerifyPackageTrust"
          Before="InstallInitialize"
          Condition="NOT Installed OR REINSTALL OR WIX_UPGRADE_DETECTED" />
      <!-- After InstallFiles; before InstallServices. Standard action ordering
           assigns this checked deferred verifier immediately before service mutation. -->
      <Custom
          Action="VerifyInstalledPayload"
          Before="InstallServices"
          Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InstallSharedRoot" After="VerifyInstalledPayload" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <InstallExecute Sequence="6500" />
      <!-- No script-generating action may intervene between this first flush
           and RemoveExistingProducts (MajorUpgrade afterInstallExecute). -->
      <Custom Action="RestoreUpgradeSnapshot" After="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackClientFirewall" After="RestoreUpgradeSnapshot" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InstallClientFirewall" After="RollbackClientFirewall" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <StartServices Sequence="6550" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitUpgradeSnapshot" After="StartServices" Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <InstallExecuteAgain After="CommitUpgradeSnapshot" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveClientFirewall" After="StopServices" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CleanupOwnedRuntime" After="RemoveClientFirewall" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CompanyFolder" Name="RegenBio">
        <Directory Id="INSTALLFOLDER" Name="OverseasAccess" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CompanyDataFolder" Name="RegenBio">
        <Directory Id="DATAFOLDER" Name="OverseasAccess" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Complete" Title="RegenBio Overseas Access" Level="1">
      <ComponentGroupRef Id="ClientFiles" />
      <ComponentGroupRef Id="FlutterFiles" />
      <ComponentGroupRef Id="ClientPolicy" />
    </Feature>
  </Package>
</Wix>
